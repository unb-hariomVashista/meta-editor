# This Caddyfile configures the reverse proxy for the Shopify app.
# It reads the SHOPIFY_APP_URL environment variable from the system.
#
# If SHOPIFY_APP_URL is an HTTP URL (e.g. http://192.168.1.100), Caddy will serve HTTP.
# If SHOPIFY_APP_URL is a domain (e.g. https://meta-editor.yourdomain.com), Caddy will automatically 
# provision and manage a Let's Encrypt/ZeroSSL certificate for HTTPS.

{$SHOPIFY_APP_URL} {
    reverse_proxy web:3000
}
